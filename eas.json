{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SERVER_URI": "https://buzzycash.viaspark.site/api/v1",
        "EXPO_PUBLIC_IMAGE_URI": "https://buzzycash.viaspark.site"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SERVER_URI": "https://buzzycash.viaspark.site/api/v1",
        "EXPO_PUBLIC_IMAGE_URI": "https://buzzycash.viaspark.site"
      }
    }
  }
}
